# ==========================================
# Open Freebie Finder Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
PROXY_MASTER_KEY=

# Provider API Keys (Fill in any keys you have for free-tier access)
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
GITHUB_PAT_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Discovery & Circuit Breaker Settings
DISCOVERY_INTERVAL_SECONDS=900
# Adaptive recovery base: integer 1..300 seconds; local exponential cap 900s.
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# Routing bounds (JSON array for optional exact provider priority)
MAX_FAILOVER_ATTEMPTS=3
ROUTING_PROVIDER_PRIORITY=[]
# Cloud inference requires current sufficient scoped evidence and a supported source profile.
# Legacy free_access_confirmed / chat_model_allowlist cannot certify free inference.
# Key presence enables permitted catalog discovery only; unknown is excluded.

# Dynamic tariff evidence (TTL must be at least twice refresh; no static certification).
ELIGIBILITY_REFRESH_SECONDS=60
ELIGIBILITY_TTL_SECONDS=120

# Conditional account mode: operator assertion, NOT machine-verified zero pricing.
# JSON provider IDs only: groq, nvidia_nim, mistral, huggingface. Default OFF.
# Assert actual account cannot bill: no PAYG/overflow/postpaid/auto-recharge,
# purchased balance, third-party billing/BYOK/bill_to. See README before enabling.
FREE_ACCOUNT_CONFIRMATIONS=[]
